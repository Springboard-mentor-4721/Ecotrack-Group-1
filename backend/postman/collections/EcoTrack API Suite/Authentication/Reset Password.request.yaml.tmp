$kind: http-request
method: POST
url: '{{baseUrl}}/api/auth/reset-password'
headers:
  - key: Content-Type
    value: application/json
body:
  type: json
  content: |-
    {
      "token": "{{resetToken}}",
      "newPassword": "newpassword123"
    }
order: 4000
scripts:
  - type: afterResponse
    language: text/javascript
    code: |-
      pm.test('Status code indicates password reset success', function () {
        pm.expect(pm.response.code).to.be.oneOf([200, 204]);
      });

      pm.test('Response time is under 2000ms', function () {
        pm.expect(pm.response.responseTime).to.be.below(2000);
      });

      const responseText = pm.response.text();
      if (responseText) {
        const contentType = (pm.response.headers.get('Content-Type') || '').toLowerCase();
        pm.test('Response content type is JSON when body is returned', function () {
          pm.expect(contentType).to.include('application/json');
        });

        const json = pm.response.json();
        pm.test('Reset password returns success message or indicator', function () {
          pm.expect(json.message || json.success || json.data).to.exist;
        });
      }
