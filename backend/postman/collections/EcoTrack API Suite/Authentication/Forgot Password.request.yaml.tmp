$kind: http-request
method: POST
url: '{{baseUrl}}/api/auth/forgot-password'
headers:
  - key: Content-Type
    value: application/json
body:
  type: json
  content: |-
    {
      "email": "test@example.com"
    }
order: 3000
scripts:
  - type: afterResponse
    language: text/javascript
    code: |-
      pm.test('Status code indicates accepted forgot-password request', function () {
        pm.expect(pm.response.code).to.be.oneOf([200, 202]);
      });

      pm.test('Response time is under 2000ms', function () {
        pm.expect(pm.response.responseTime).to.be.below(2000);
      });

      const contentType = (pm.response.headers.get('Content-Type') || '').toLowerCase();
      if (pm.response.text()) {
        pm.test('Response content type is JSON', function () {
          pm.expect(contentType).to.include('application/json');
        });

        const json = pm.response.json();
        pm.test('Forgot password returns a message or success indicator', function () {
          pm.expect(json.message || json.success || json.data).to.exist;
        });

        const token = json.resetToken || (json.data && json.data.resetToken);
        if (token) {
          pm.collectionVariables.set('resetToken', String(token));
        }
      }
