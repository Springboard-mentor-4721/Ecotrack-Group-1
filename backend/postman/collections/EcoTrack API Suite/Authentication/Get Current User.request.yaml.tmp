$kind: http-request
method: GET
url: '{{baseUrl}}/api/users/me'
headers:
  - key: Authorization
    value: 'Bearer {{jwtToken}}'
order: 5000
scripts:
  - type: afterResponse
    language: text/javascript
    code: |-
      pm.test('Status code is 200', function () {
        pm.expect(pm.response.code).to.eql(200);
      });

      pm.test('Response time is under 2000ms', function () {
        pm.expect(pm.response.responseTime).to.be.below(2000);
      });

      const contentType = (pm.response.headers.get('Content-Type') || '').toLowerCase();
      pm.test('Response content type is JSON', function () {
        pm.expect(contentType).to.include('application/json');
      });

      const json = pm.response.json();
      const user = json.data || json.user || json;

      pm.test('Current user response returns an object', function () {
        pm.expect(user).to.be.an('object');
      });

      pm.test('Current user response contains a user identifier', function () {
        pm.expect(user.id || user.email || user.username).to.exist;
      });

      if (user.email !== undefined) {
        pm.test('Current user email looks valid', function () {
          pm.expect(String(user.email)).to.include('@');
        });
      }
