<div class="space-y-8 animate-fade-in">
  
  <!-- Loading State -->
  <div *ngIf="isLoading" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div *ngFor="let i of [1,2,3,4]" class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm animate-pulse">
        <div class="h-4 bg-gray-200 rounded w-1/3 mb-4"></div>
        <div class="h-8 bg-gray-200 rounded w-1/2 mb-2"></div>
        <div class="h-3 bg-gray-100 rounded w-2/3"></div>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div *ngIf="error && !isLoading" class="bg-red-50 p-6 rounded-xl border border-red-100 flex flex-col items-center justify-center text-center space-y-4">
    <div class="bg-red-100 p-3 rounded-full">
      <lucide-icon [img]="CircleAlertIcon" class="w-6 h-6 text-red-600"></lucide-icon>
    </div>
    <div>
      <h3 class="text-lg font-medium text-red-800">Unable to load your analytics</h3>
      <p class="text-red-600 mt-1">{{ error }}</p>
    </div>
    <button (click)="loadData()" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors shadow-sm text-sm font-medium">
      Try Again
    </button>
  </div>

  <!-- Empty State -->
  <div *ngIf="data && !isLoading && data.totalEmissions === 0 && data.activeGoals === 0 && data.completedGoals === 0 && data.completedChallenges === 0 && data.periodXpEarned === 0" class="bg-white p-12 rounded-xl border border-gray-100 shadow-sm text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-50 mb-4">
      <lucide-icon [img]="ChartNoAxesColumnIcon" class="w-8 h-8 text-gray-400"></lucide-icon>
    </div>
    <h3 class="text-xl font-medium text-gray-900">No activity for this period</h3>
    <p class="text-gray-500 mt-2 max-w-md mx-auto">There isn't enough sustainability activity to generate an overview for the selected dates. Try selecting a longer date range.</p>
  </div>

  <!-- Data View -->
  <ng-container *ngIf="data && !isLoading && (data.totalEmissions !== 0 || data.activeGoals !== 0 || data.completedGoals !== 0 || data.completedChallenges !== 0 || data.periodXpEarned !== 0)">
    
    <!-- 1. Environmental Impact -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <div class="p-1.5 bg-emerald-100 text-emerald-600 rounded-lg">
          <lucide-icon [img]="LeafIcon" class="w-5 h-5"></lucide-icon>
        </div>
        Environmental Impact
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-gray-500">Total Emissions</h3>
            <lucide-icon [img]="CloudIcon" class="w-4 h-4 text-gray-400"></lucide-icon>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="text-3xl font-bold text-gray-900">{{ data.totalEmissions | number:'1.0-1' }}</span>
            <span class="text-sm font-medium text-gray-500">kg CO₂e</span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Total emissions for selected period</p>
        </div>

      </div>
    </section>

    <!-- 2. Sustainability Activity -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <div class="p-1.5 bg-blue-100 text-blue-600 rounded-lg">
          <lucide-icon [img]="TargetIcon" class="w-5 h-5"></lucide-icon>
        </div>
        Sustainability Activity
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-gray-500">Active Goals</h3>
            <lucide-icon [img]="TrendingUpIcon" class="w-4 h-4 text-blue-400"></lucide-icon>
          </div>
          <div class="text-3xl font-bold text-gray-900">{{ data.activeGoals }}</div>
          <p class="text-xs text-gray-400 mt-1">Goals currently in progress</p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-gray-500">Completed Goals</h3>
            <lucide-icon [img]="CircleCheckIcon" class="w-4 h-4 text-emerald-500"></lucide-icon>
          </div>
          <div class="text-3xl font-bold text-gray-900">{{ data.completedGoals }}</div>
          <p class="text-xs text-gray-400 mt-1">Goals finished this period</p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-gray-500">Completed Challenges</h3>
            <lucide-icon [img]="AwardIcon" class="w-4 h-4 text-amber-500"></lucide-icon>
          </div>
          <div class="text-3xl font-bold text-gray-900">{{ data.completedChallenges }}</div>
          <p class="text-xs text-gray-400 mt-1">Challenges conquered</p>
        </div>

      </div>
    </section>

    <!-- 3. Gamification -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <div class="p-1.5 bg-purple-100 text-purple-600 rounded-lg">
          <lucide-icon [img]="ZapIcon" class="w-5 h-5"></lucide-icon>
        </div>
        Gamification
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow border-l-4 border-l-purple-500">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-gray-500">XP Earned</h3>
            <lucide-icon [img]="ZapIcon" class="w-4 h-4 text-purple-500"></lucide-icon>
          </div>
          <div class="text-3xl font-bold text-gray-900">+{{ data.periodXpEarned | number }}</div>
          <p class="text-xs text-gray-400 mt-1">XP earned during selected period</p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-gray-500">Current EcoScore</h3>
            <lucide-icon [img]="ChartNoAxesColumnIcon" class="w-4 h-4 text-indigo-400"></lucide-icon>
          </div>
          <div class="text-3xl font-bold text-gray-900">{{ data.currentEcoScore | number }}</div>
          <p class="text-xs text-gray-400 mt-1">Total accumulated score</p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-gray-500">Current Level</h3>
            <lucide-icon [img]="StarIcon" class="w-4 h-4 text-yellow-400"></lucide-icon>
          </div>
          <div class="text-3xl font-bold text-gray-900">{{ data.currentLevel }}</div>
          <p class="text-xs text-gray-400 mt-1">Your current gamification rank</p>
        </div>

      </div>
    </section>

    <!-- Quick Navigation -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <div class="p-1.5 bg-gray-100 text-gray-600 rounded-lg">
          <lucide-icon [img]="CompassIcon" class="w-5 h-5"></lucide-icon>
        </div>
        Quick Analytics
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <button (click)="onNavigate('carbon')" class="text-left bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:border-emerald-300 hover:shadow-md transition-all group">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-gray-900 group-hover:text-emerald-600 transition-colors">Carbon Analytics</h3>
            <lucide-icon [img]="ArrowRightIcon" class="w-4 h-4 text-gray-400 group-hover:text-emerald-500 transition-colors"></lucide-icon>
          </div>
          <p class="text-xs text-gray-500">Explore emissions trends and categories</p>
        </button>

        <button (click)="onNavigate('goals')" class="text-left bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:border-blue-300 hover:shadow-md transition-all group">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">Goals Analytics</h3>
            <lucide-icon [img]="ArrowRightIcon" class="w-4 h-4 text-gray-400 group-hover:text-blue-500 transition-colors"></lucide-icon>
          </div>
          <p class="text-xs text-gray-500">Review goal progress</p>
        </button>

        <button (click)="onNavigate('challenges')" class="text-left bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:border-amber-300 hover:shadow-md transition-all group">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-gray-900 group-hover:text-amber-600 transition-colors">Challenge Analytics</h3>
            <lucide-icon [img]="ArrowRightIcon" class="w-4 h-4 text-gray-400 group-hover:text-amber-500 transition-colors"></lucide-icon>
          </div>
          <p class="text-xs text-gray-500">Review participation and completion</p>
        </button>

        <button (click)="onNavigate('xp-activity')" class="text-left bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:border-purple-300 hover:shadow-md transition-all group">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-gray-900 group-hover:text-purple-600 transition-colors">XP Activity</h3>
            <lucide-icon [img]="ArrowRightIcon" class="w-4 h-4 text-gray-400 group-hover:text-purple-500 transition-colors"></lucide-icon>
          </div>
          <p class="text-xs text-gray-500">View your XP history</p>
        </button>

      </div>
    </section>

  </ng-container>
</div>
